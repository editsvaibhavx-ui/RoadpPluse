{
  "name": "urban-intelligence-platform",
  "version": "2.0.0",
  "private": true,
  "description": "AI-Powered Mobile Urban Intelligence Platform Using Public Transport Fleet",
  "scripts": {
    "dev": "start_all.bat",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev:host",
    "build": "cd frontend && npm run build",
    "reset:db": "python database/reset_database.py",
    "test:integration": "python backend/test_pipeline_integration.py"
  }
}
