# ==============================================================================
# RoadPulse AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local development or set these variables in your
# hosting provider's dashboard (e.g. Vercel for frontend, Render for backend).

# ------------------------------------------------------------------------------
# Backend Configuration (Set on Render / Railway / Local Environment)
# ------------------------------------------------------------------------------

# The port the backend server listens on (Render automatically supplies $PORT, default: 8000)
PORT=8000

# The host network interface to bind to (use 0.0.0.0 for cloud deployments)
HOST=0.0.0.0

# Database connection URL (supports SQLite locally, or PostgreSQL/MySQL in production)
# Examples:
#   SQLite (default): sqlite:///database/urbansense.db
#   Render / Supabase PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///database/urbansense.db

# Secret key used for signing JWT authentication tokens
SECRET_KEY=roadpulse-urban-intelligence-super-secret-key-2025

# Allowed CORS origins for cross-origin frontend requests
# Use "*" to allow all origins, or comma-separated list like "https://your-frontend.vercel.app,http://localhost:5173"
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Frontend Configuration (Set on Vercel / Netlify / Local Vite Environment)
# ------------------------------------------------------------------------------

# Public backend API URL that the Vite/React frontend makes requests to.
# For local development: http://localhost:8000
# For production (Vercel): https://roadpulse-backend.onrender.com (replace with your Render backend URL)
VITE_API_URL=http://localhost:8000
